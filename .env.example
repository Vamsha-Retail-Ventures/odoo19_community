# =========================================================================
# ODOO V19 CODESPACE ENVIRONMENT VARIABLES
# =========================================================================

# Database Connection (PostgreSQL Container Configuration)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_secure_db_pass_2026
POSTGRES_DB=postgres

# Odoo Engine Configuration (Links Odoo to the DB container)
HOST=db
USER=odoo
PASSWORD=odoo_secure_db_pass_2026
ODOO_RC=/etc/odoo/odoo.conf

# Odoo Master Web UI Password (For database creation/backups)
ODOO_ADMIN_PASSWORD=odoo_master_super_secure_pass
# Backward compatibility alias
ODOO_ADMIN_PASSWD=odoo_master_super_secure_pass
